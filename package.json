{
  "name": "la-apartment-receiver",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev",
    "build": "bash scripts/build-verified.sh",
    "build:netlify": "npm run build && node scripts/export-netlify-static.mjs",
    "start": "next dev",
    "test": "npm run build:netlify && npm run test:unit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:unit": "NODE_ENV=test node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm test && npm run lint && npm run typecheck && node scripts/check-public-artifact.mjs && node scripts/package-functions.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@netlify/functions": "6.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "LA Apartment Receiver",
  "packageManager": "npm@10.9.8",
  "overrides": {
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
