{
  "name": "la-apartment-receiver",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:netlify": "npm run build && node scripts/export-netlify-static.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:netlify && npm run test:unit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:unit": "NODE_ENV=test node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm test && npm run lint && npm run typecheck && node scripts/check-public-artifact.mjs && node scripts/package-functions.mjs",
    "deploy:preview": "npm run verify && netlify deploy --no-build",
    "deploy:production": "RECEIVER_RELEASE=production npm run verify && netlify deploy --prod --no-build"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@netlify/functions": "6.0.0",
    "@netlify/zip-it-and-ship-it": "15.5.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "netlify-cli": "27.5.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.16",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "displayName": "LA Apartment Receiver",
  "packageManager": "npm@10.9.8",
  "overrides": {
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
