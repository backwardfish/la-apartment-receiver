# Local development only. Real values belong in ignored files or Netlify.
# Live source must be explicit. Use zillow-apify for the LA MVP; rentcast remains compatibility-only.
LISTING_PROVIDER=zillow-apify
# Apify API token for LISTING_PROVIDER=zillow-apify (Apify Console -> Settings -> API & Integrations).
APIFY_TOKEN=
RENTCAST_API_KEY=
# Optional: Santa Monica neighborhood estimates work without Routes.
GOOGLE_ROUTES_API_KEY=
# Only an explicit true enables provider calls. Redeploy after changing it.
LIVE_SEARCH_ENABLED=false
# Optional shared allowance overrides; defaults apply when omitted.
# Counts persist across deployments. UTC calendar windows; failed searches count.
RECEIVER_SEARCHES_PER_DAY=25
RECEIVER_SEARCHES_PER_MONTH=50
